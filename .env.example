NEXT_PUBLIC_SITE_URL=https://www.sendagift.ug
AWS_REGION=eu-north-1
SES_FROM_EMAIL=your_verified_ses_sender@example.com
DYNAMODB_TABLE=giftora-main
DYNAMODB_ORDER_TABLE=giftora-orders
ADMIN_TOKEN=your_admin_token_here
BOOTSTRAP_SUPER_ADMIN_EMAILS=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Pesapal API 3.0 JSON payment integration
# Sandbox: https://cybqa.pesapal.com/pesapalv3
# Production: https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
# Set this to the ipn_id returned by POST /api/pesapal/register-ipn, not the URL.
PESAPAL_IPN_ID=your_registered_ipn_id


# Auth.js / NextAuth Google sign-in
# Generate with: npx auth secret
AUTH_SECRET=your_auth_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
AUTH_URL=http://localhost:3000
# NEXTAUTH_URL is accepted by NextAuth deployments that still use the legacy name.
NEXTAUTH_URL=http://localhost:3000
